# Local development settings. Copy to .env and fill in the passwords (.env is gitignored).
# Read by docker compose (database container) and by Spring Boot (spring.config.import).
# Use long random values, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Postgres superuser inside the container (setup only; the backend never uses it)
POSTGRES_PASSWORD=

DB_HOST=localhost
DB_PORT=5433
DB_NAME=goaway

# Schema owner: used only by Flyway to run migrations
DB_OWNER_USER=goaway_owner
DB_OWNER_PASSWORD=

# Runtime role used by the backend: read/write data, no schema changes
DB_APP_USER=goaway_app
DB_APP_PASSWORD=

# Access-token signing key pair (ES256, curve P-256), base64-encoded DER. Generate a pair with:
#   node -e "const k=require('crypto').generateKeyPairSync('ec',{namedCurve:'prime256v1',publicKeyEncoding:{type:'spki',format:'der'},privateKeyEncoding:{type:'pkcs8',format:'der'}});console.log('JWT_PRIVATE_KEY='+k.privateKey.toString('base64')+'\nJWT_PUBLIC_KEY='+k.publicKey.toString('base64'))"
# The private key signs every login token: never commit or share it. Each environment gets its own pair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Web frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: Google OAuth client IDs accepted as ID-token audiences (comma-separated). Defaults to the project's
# Web and iOS clients (see application.properties); override only for a different Google Cloud project.
# GOOGLE_CLIENT_IDS=

# Google Web client's secret (Google Cloud -> Google Auth Platform -> Clients -> Goaway Web). Enables the website's
# custom Google button (authorization-code flow). Secret: never commit or share it. Empty = that flow is disabled.
GOOGLE_CLIENT_SECRET=
