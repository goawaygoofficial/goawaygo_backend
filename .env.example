# Local development settings. Copy to .env and fill in the passwords (.env is gitignored).
# Read by docker compose (database container) and by Spring Boot (spring.config.import).
# Use long random values, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Postgres superuser inside the container (setup only; the backend never uses it)
POSTGRES_PASSWORD=

DB_HOST=localhost
DB_PORT=5433
DB_NAME=goaway

# Schema owner: used only by Flyway to run migrations
DB_OWNER_USER=goaway_owner
DB_OWNER_PASSWORD=

# Runtime role used by the backend: read/write data, no schema changes
DB_APP_USER=goaway_app
DB_APP_PASSWORD=
